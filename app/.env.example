# ─────────────────────────────────────────────────────────────
# Rudder configuration — copy to .env.local and edit as needed.
#   cp app/.env.example app/.env.local
#
# Everything here is OPTIONAL. With Ollama running locally and no
# .env.local at all, Rudder works fully offline out of the box.
# ─────────────────────────────────────────────────────────────

# ── Local AI (recommended path) ──────────────────────────────
# Your local Ollama endpoint. This is the only network call Rudder
# makes on the happy path — and it's to localhost.
OLLAMA_URL=http://localhost:11434

# Optional extra Ollama nodes to try if the primary is down
# (comma-separated). Leave empty unless you run a cluster.
OLLAMA_FALLBACK_URLS=

# Optional: an exo cluster endpoint (OpenAI-compatible), if you use one.
EXO_URL=http://localhost:52415
EXO_FALLBACK_URLS=

# ── Cloud fallback (off by default) ──────────────────────────
# If set, Rudder may fall back to a cloud model when local is
# unreachable. Setting either of these means that data — and only
# that data — leaves your machine, by your explicit choice.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Storage ──────────────────────────────────────────────────
# Where the local SQLite store lives. Defaults to <repo>/data.
# Pin this if you launch Rudder (e.g. the MCP server) from elsewhere.
# RUDDER_DATA_DIR=/absolute/path/to/data

# ── Ingest door (/api/ingest) ────────────────────────────────
# If set, the local ingest endpoint requires this token (Bearer or
# x-ingest-token header). Leave empty to allow local, unauthenticated
# pushes during development.
RUDDER_INGEST_TOKEN=

# Local speech-to-text endpoint for audio capture (whisper.cpp server
# or any OpenAI-compatible /transcriptions endpoint).
WHISPER_URL=http://localhost:8080/inference

# ── Auth (optional, for exposing Rudder beyond localhost) ─────
# Generate a password hash with: node app/scripts/set-password.js
RUDDER_PASSWORD_HASH=
# A random secret used to sign sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUDDER_SESSION_SECRET=
